{
  "name": "sphinx-understand",
  "version": "0.1.19",
  "description": "You can outsource your thinking, but not your understanding. A comprehension checkpoint for agent-assisted development.",
  "homepage": "https://github.com/parthh01/sphinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthh01/sphinx.git"
  },
  "bugs": {
    "url": "https://github.com/parthh01/sphinx/issues"
  },
  "type": "module",
  "bin": {
    "sphinx": "bin/sphinx.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/run-suite.mjs",
    "check": "node --check bin/sphinx.js && node scripts/run-suite.mjs",
    "start": "node bin/sphinx.js",
    "eval": "node eval/run.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "bin",
    "src",
    "scripts/postinstall.js",
    "docs",
    "!docs/demo.gif",
    "eval/RESULTS.md",
    "eval/fixtures/known-false-negatives.json",
    "examples",
    ".sphinxconfig.example",
    ".sphinxignore.example",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "git",
    "hooks",
    "codex",
    "claude-code",
    "learning",
    "code-review"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0"
  }
}
